{
  "expo": {
    "name": "Pengolo",
    "slug": "pengolo",
    "scheme": "pengolo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#E4F1FB",
    "platforms": [
      "ios"
    ],
    "locales": {
      "tr": "./locales/tr.json",
      "en": "./locales/en.json"
    },
    "ios": {
      "bundleIdentifier": "com.serhatonal.pengoloGame",
      "buildNumber": "2",
      "supportsTablet": true,
      "requireFullScreen": true,
      "infoPlist": {
        "CFBundleDevelopmentRegion": "en",
        "CFBundleAllowMixedLocalizations": true,
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "UL2V6DD422",
      "entitlements": {
        "com.apple.developer.game-center": true
      }
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-font",
        {
          "ios": {
            "fonts": [
              "node_modules/@expo-google-fonts/nunito/600SemiBold/Nunito_600SemiBold.ttf",
              "node_modules/@expo-google-fonts/nunito/700Bold/Nunito_700Bold.ttf",
              "node_modules/@expo-google-fonts/nunito/800ExtraBold/Nunito_800ExtraBold.ttf",
              "node_modules/@expo-google-fonts/nunito/900Black/Nunito_900Black.ttf"
            ]
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E4F1FB",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#0D1830"
          }
        }
      ],
      "expo-localization",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-sharing",
      "expo-asset",
      "./plugins/withKvsOnlyICloud",
      "@nauverse/expo-cloud-settings",
      [
        "./plugins/withKvsOnlyICloud",
        {
          "pass": 2
        }
      ],
      "expo-iap",
      [
        "react-native-google-mobile-ads",
        {
          "iosAppId": "ca-app-pub-4475107857161348~1452749598",
          "delayAppMeasurementInit": true,
          "userTrackingUsageDescription": "This lets the ads you see be more relevant. The game works the same either way.",
          "skAdNetworkItems": [
            "cstr6suwn9.skadnetwork"
          ]
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "This lets the ads you see be more relevant. The game works the same either way."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
